{
  "name": "holiday-hue",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Holiday Hue — dress your Philips Hue lights for the holidays: themes, twinkles, and color patterns that keep running after you lock your phone",
  "scripts": {
    "dev": "vite",
    "typecheck:amplify": "tsc --noEmit -p amplify/tsconfig.json",
    "typecheck:runner": "tsc --noEmit -p runner/tsconfig.json",
    "build": "tsc && npm run typecheck:amplify && npm run typecheck:runner && vite build",
    "preview": "vite preview",
    "prod-config": "node scripts/prod-config.mjs",
    "e2e-config": "node scripts/sandbox.mjs config",
    "sandbox:deploy": "node scripts/sandbox.mjs deploy",
    "sandbox:delete": "node scripts/sandbox.mjs delete",
    "sandbox:name": "node scripts/sandbox.mjs name",
    "sandbox:sweep": "node scripts/sandbox.mjs sweep",
    "ensure-editor": "node scripts/ensure-editor.mjs",
    "gen:icons": "node scripts/gen-app-icons.mjs",
    "seed": "tsx amplify/seed/seed.ts",
    "runner": "tsx runner/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bddgen && playwright test",
    "crap": "node scripts/crap-check.mjs",
    "check:lines": "node scripts/check-file-lines.mjs",
    "check:features": "node scripts/check-feature-coverage.mjs",
    "check:dead": "knip",
    "check:dup": "jscpd src amplify runner",
    "check:halstead": "node scripts/check-halstead.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run lint && npm run format:check && npm run check:lines && npm run check:dead && npm run check:dup && npm run check:halstead && npm run check:features && npm run test:coverage && npm run crap && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/status-bar": "^8.0.4",
    "@ionic/react": "^8.5.0",
    "@ionic/react-router": "^8.5.0",
    "@tanstack/react-query": "^5.101.0",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "aws-amplify": "^6.18.0",
    "ionicons": "^7.4.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.23.0",
    "@aws-amplify/backend-cli": "^1.8.3",
    "@aws-sdk/client-cognito-identity-provider": "^3.1164.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.61.0",
    "@testing-library/dom": ">=7.21.4",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "^4.0.1",
    "@vitest/coverage-istanbul": "^0.34.6",
    "aws-cdk-lib": "^2.244.0",
    "constructs": "^10.6.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jscpd": "^4.0.5",
    "jsdom": "^22.1.0",
    "knip": "^5.50.0",
    "lint-staged": "^17.0.8",
    "playwright-bdd": "^9.2.0",
    "prettier": "^3.8.4",
    "sharp": "^0.33.5",
    "terser": "^5.4.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^5.0.0",
    "vitest": "^0.34.6"
  }
}
